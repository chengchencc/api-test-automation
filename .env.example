# 环境配置
ENVIRONMENT=test

# API配置
API_BASE_URL=http://api.example.com
REQUEST_TIMEOUT=30
VERIFY_SSL=False
MAX_RETRY=3

# OAuth 2.0 配置
OAUTH2_ENABLED=True
OAUTH2_AUTH_URL=http://api.example.com/oauth/authorize
OAUTH2_TOKEN_URL=http://api.example.com/oauth/token
OAUTH2_REFRESH_URL=http://api.example.com/oauth/token
OAUTH2_REVOKE_URL=http://api.example.com/oauth/revoke
OAUTH2_INTROSPECT_URL=http://api.example.com/oauth/introspect

# 客户端凭证
OAUTH2_CLIENT_ID=test_client_id
OAUTH2_CLIENT_SECRET=test_client_secret
OAUTH2_SCOPE=read write

# 资源所有者凭证（密码模式）
OAUTH2_USERNAME=test_user
OAUTH2_PASSWORD=test_password

# 授权类型
OAUTH2_GRANT_TYPE=password  # password, client_credentials, authorization_code

# 令牌配置
OAUTH2_TOKEN_EXPIRY_THRESHOLD=300  # 5分钟
OAUTH2_AUTO_REFRESH=True

# 数据库配置（可选）
DATABASE_URL=postgresql://user:password@localhost:5432/testdb
REDIS_URL=redis://localhost:6379/0

# 测试账号
TEST_USERNAME=admin
TEST_PASSWORD=admin123
TEST_AUTH_TOKEN=

# 邮件配置（可选）
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=user@example.com
EMAIL_PASSWORD=password

# 日志配置
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(filename)s:%(lineno)d - %(message)s

# 测试配置
TEST_RUNNER=pytest
TEST_PARALLEL=False
TEST_RERUNS=0

# 模板配置
TEMPLATE_AUTO_RELOAD=True
TEMPLATE_STRICT_MODE=False